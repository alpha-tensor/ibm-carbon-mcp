{
  "name": "ibm-carbon-mcp",
  "version": "1.0.0",
  "description": "MCP server for IBM Carbon documentation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ibm-carbon-mcp": "bin/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:north-star": "vitest run src/services/documentation.test.ts",
    "sync:carbon-docs": "tsx scripts/sync-carbon-docs.ts",
    "build:index": "tsx src/services/search-index.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "ibm-carbon",
    "documentation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
